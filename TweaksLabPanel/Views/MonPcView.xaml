<UserControl x:Class="TweaksLabPanel.Views.MonPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer Style="{StaticResource PageScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="920">

            <Grid Margin="0,0,0,14">
                <StackPanel Margin="0,0,220,0">
                    <TextBlock Text="{h:Loc Fr='Mon PC', En='My PC'}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{h:Loc Fr='Configuration et températures de tes composants.', En='Your components’ specs and temperatures.'}"
                               Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0" Click="ShareSpecs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{h:Loc Fr='Partager', En='Share'}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Padding="14,8" Click="CopySpecs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{h:Loc Fr='Copier', En='Copy'}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel HorizontalAlignment="Center">
                <StackPanel Width="580">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{h:Loc Fr='Température CPU', En='CPU temperature'}" FontSize="12"
                                           Foreground="{StaticResource TextGrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CpuTempText" Text="—" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CpuTempNote" FontSize="10" Foreground="{StaticResource TextGrayBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="240" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{h:Loc Fr='Température GPU', En='GPU temperature'}" FontSize="12"
                                           Foreground="{StaticResource TextGrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock x:Name="GpuTempText" Text="—" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="GpuTempNote" FontSize="10" Foreground="{StaticResource TextGrayBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="240" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{h:Loc Fr='SANTÉ DU DISQUE SYSTÈME', En='SYSTEM DISK HEALTH'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid>
                                <TextBlock x:Name="DiskSpaceText" Text="—" FontSize="13" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock x:Name="DiskPercentText" Text="—" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="DiskBar" Height="8" Margin="0,10,0,6" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="DiskWarningText" Text="{h:Loc Fr='Espace disque faible (&lt; 10 %)', En='Low disk space (&lt; 10%)'}"
                                       Foreground="#FFFF6B6B" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="{h:Loc Fr='SYSTÈME', En='SYSTEM'}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="148"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource GlassSurfaceLightBrush}"
                                        BorderBrush="{StaticResource BorderFaintBrush}" BorderThickness="1" Margin="0,0,10,8">
                                    <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{h:Loc Fr='Système d’exploitation', En='Operating system'}" FontSize="13"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="OsText" Grid.Row="0" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border Grid.Row="1" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource GlassSurfaceLightBrush}"
                                        BorderBrush="{StaticResource BorderFaintBrush}" BorderThickness="1" Margin="0,0,10,8">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{h:Loc Fr='Processeur', En='Processor'}" FontSize="13"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="CpuText" Grid.Row="1" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border Grid.Row="2" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource GlassSurfaceLightBrush}"
                                        BorderBrush="{StaticResource BorderFaintBrush}" BorderThickness="1" Margin="0,0,10,8">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{h:Loc Fr='Carte graphique', En='Graphics card'}" FontSize="13"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="GpuText" Grid.Row="2" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border Grid.Row="3" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource GlassSurfaceLightBrush}"
                                        BorderBrush="{StaticResource BorderFaintBrush}" BorderThickness="1" Margin="0,0,10,8">
                                    <TextBlock Text="&#xE964;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{h:Loc Fr='Mémoire vive', En='Memory (RAM)'}" FontSize="13"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="RamText" Grid.Row="3" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                <Border Grid.Row="4" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource GlassSurfaceLightBrush}"
                                        BorderBrush="{StaticResource BorderFaintBrush}" BorderThickness="1" Margin="0,0,10,8">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{h:Loc Fr='Carte mère', En='Motherboard'}" FontSize="13"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="BoardText" Grid.Row="4" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border Grid.Row="5" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource GlassSurfaceLightBrush}"
                                        BorderBrush="{StaticResource BorderFaintBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{h:Loc Fr='Stockage', En='Storage'}" FontSize="13"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StorageText" Grid.Row="5" Grid.Column="3" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextWhiteBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
