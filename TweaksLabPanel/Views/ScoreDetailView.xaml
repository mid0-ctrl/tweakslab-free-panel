<UserControl x:Class="TweaksLabPanel.Views.ScoreDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="OfferTag" TargetType="Border">
            <Setter Property="Background" Value="#227C3AED"/>
            <Setter Property="BorderBrush" Value="#55A855F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="OfferTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" Style="{StaticResource PageScrollViewer}" Margin="{StaticResource PageMargin}">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center">
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,14"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{h:Loc Fr='Retour à l’accueil', En='Back to home'}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{h:Loc Fr='Détail de ton score', En='Your score breakdown'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{h:Loc Fr='Score de santé de 0 à 90 : la perfection n’existe pas. Chaque critère est mesuré sur ton PC, rien n’est inventé.', En='Health score from 0 to 90: nothing is perfect. Every criterion is measured on your PC, nothing is made up.'}"
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,18"/>

            <!-- Résumé -->
            <Border Style="{StaticResource GlassCard}" Padding="22,16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ScoreValueText" Text="—" FontSize="40" FontWeight="Bold" Foreground="{StaticResource TextWhiteBrush}"/>
                        <TextBlock Text="/90" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextGrayBrush}"
                                   VerticalAlignment="Bottom" Margin="3,0,0,9"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BandText" FontSize="{StaticResource FontMedium}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextWhiteBrush}"/>
                        <TextBlock x:Name="LastScanText" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextGrayBrush}"/>
                    </StackPanel>
                    <Button x:Name="RescanButton" Grid.Column="2" Style="{StaticResource BlueButton}" Padding="16,10"
                            VerticalAlignment="Center" Click="Rescan_Click"
                            Content="{h:Loc Fr='Recalculer mon score', En='Recalculate my score'}"/>
                </Grid>
            </Border>

            <StackPanel x:Name="CategoriesHost"/>

            <!-- Hors score : ce que l'optimisation complète ajoute (sans détailler le savoir-faire) -->
            <Border Style="{StaticResource GlassCard}" Padding="20,16" Margin="0,4,0,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{h:Loc Fr='Ce que l’optimisation complète ajoute', En='What the full optimization adds'}"
                                   FontSize="{StaticResource FontNormal}" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"/>
                        <Border HorizontalAlignment="Right" Background="#22FFFFFF" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="{h:Loc Fr='Hors score', En='Not scored'}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightGrayBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,6,0,10" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{StaticResource TextLightGrayBrush}"
                               Text="{h:Loc Fr='Ce score mesure les bases que tu peux régler toi-même. L’optimisation complète va au-delà avec les réglages exclusifs de l’équipe TweaksLab, qui ne sont pas comptés ici.', En='This score measures the basics you can set yourself. The full optimization goes further with the TweaksLab team’s exclusive settings, which aren’t counted here.'}"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource OfferTag}">
                            <TextBlock Text="{h:Loc Fr='BIOS optimisé', En='Optimized BIOS'}" Style="{StaticResource OfferTagText}"/>
                        </Border>
                        <Border Style="{StaticResource OfferTag}">
                            <TextBlock Text="{h:Loc Fr='Processeur optimisé', En='Optimized CPU'}" Style="{StaticResource OfferTagText}"/>
                        </Border>
                        <Border Style="{StaticResource OfferTag}">
                            <TextBlock Text="{h:Loc Fr='Windows optimisé en profondeur', En='Windows optimized in depth'}" Style="{StaticResource OfferTagText}"/>
                        </Border>
                        <Border Style="{StaticResource OfferTag}">
                            <TextBlock Text="{h:Loc Fr='Tweaks exclusifs TweaksLab', En='Exclusive TweaksLab tweaks'}" Style="{StaticResource OfferTagText}"/>
                        </Border>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OfferText" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="{StaticResource FontSmall}"
                                   TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource TextWhiteBrush}"/>
                        <Button Grid.Column="1" Style="{StaticResource PurpleButton}" VerticalAlignment="Center"
                                Content="{h:Loc Fr='Découvrir l’optimisation', En='Discover the optimization'}" Click="Offer_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
