<UserControl x:Class="TweaksLabPanel.Views.RecommandationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer Style="{StaticResource PageScrollViewer}" Margin="{StaticResource PageMargin}">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="{h:Loc Fr='Nos recommandations', En='Our recommendations'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{h:Loc Fr='Pour garder ton PC rapide et stable dans le temps.', En='To keep your PC fast and stable over time.'}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,24"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                            <Run Text="● " Foreground="{StaticResource PurpleAccentBrush}"/>
                            <Run Text="{h:Loc Fr='Utiliser uniquement les pilotes recommandés', En='Only use the recommended drivers'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{h:Loc Fr='    Installe uniquement les pilotes que nous recommandons. Évite d’installer d’autres versions ou des logiciels supplémentaires liés aux pilotes.', En='    Only install the drivers we recommend. Avoid other versions or extra driver-related software.'}" Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                            <Run Text="● " Foreground="{StaticResource PurpleAccentBrush}"/>
                            <Run Text="{h:Loc Fr='Éviter les scripts ou modifications externes', En='Avoid external scripts or tweaks'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{h:Loc Fr='    N’utilise pas de scripts batch externes, de tweaks non vérifiés ni de modifications du registre Windows non validées.', En='    Don’t use external batch scripts, unverified tweaks or unvalidated Windows registry changes.'}" Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                            <Run Text="● " Foreground="{StaticResource PurpleAccentBrush}"/>
                            <Run Text="{h:Loc Fr='Ne pas utiliser d’autres logiciels d’optimisation', En='Don’t use other optimization software'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{h:Loc Fr='    Les logiciels d’optimisation tiers ne sont pas conseillés : ils peuvent entrer en conflit avec notre optimisation.', En='    Third-party optimization tools aren’t recommended: they can conflict with our optimization.'}" Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                            <Run Text="● " Foreground="{StaticResource PurpleAccentBrush}"/>
                            <Run Text="{h:Loc Fr='Installer le minimum de logiciels possible', En='Install as little software as possible'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{h:Loc Fr='    Moins tu installes de programmes, plus ton système restera rapide et stable.', En='    The fewer programs you install, the faster and more stable your system stays.'}" Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                            <Run Text="● " Foreground="{StaticResource PurpleAccentBrush}"/>
                            <Run Text="{h:Loc Fr='Éviter les applications inutiles au démarrage', En='Avoid unnecessary startup apps'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{h:Loc Fr='    Trop de programmes qui se lancent au démarrage peuvent ralentir ton PC et provoquer du lag.', En='    Too many programs launching at startup can slow your PC down and cause lag.'}" Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                            <Run Text="● " Foreground="{StaticResource PurpleAccentBrush}"/>
                            <Run Text="{h:Loc Fr='Garder le système propre', En='Keep your system clean'}" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="{h:Loc Fr='    Désinstalle les programmes inutiles et évite d’accumuler des applications que tu n’utilises pas.', En='    Uninstall programs you don’t need and avoid piling up apps you don’t use.'}" Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="RecommendationsOfferLink" Margin="4,16,0,8" Style="{StaticResource AccentLink}" TextWrapping="Wrap"
                       MouseLeftButtonUp="RecommendationsOffer_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
