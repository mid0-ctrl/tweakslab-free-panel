<UserControl x:Class="TweaksLabPanel.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer x:Name="PageScroll" Style="{StaticResource PageScrollViewer}" Margin="{StaticResource PageMargin}">
        <StackPanel MaxWidth="860" HorizontalAlignment="Center">
            <TextBlock Text="{h:Loc Fr='Optimiser ton GPU', En='Optimize your GPU'}" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PageSubtitleText" Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" Margin="0,0,0,28"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <!-- Sélection NVIDIA / AMD -->
            <StackPanel x:Name="SelectionPanel">
                <Border x:Name="OnboardingGpuCard" Style="{StaticResource GlassCard}" Padding="28,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{h:Loc Fr='QUELLE EST TA CARTE GRAPHIQUE ?', En='WHICH GRAPHICS CARD DO YOU HAVE?'}" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <StackPanel x:Name="OnboardingGpuChoices" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="NvidiaCard" Width="200" Height="200" CornerRadius="24"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                                    Background="{StaticResource GlassSurfaceMediumBrush}"
                                    Cursor="Hand" Margin="0,0,20,0"
                                    MouseLeftButtonUp="NvidiaCard_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image x:Name="NvidiaLogo" Width="120" Height="120"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="NVIDIA" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextWhiteBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AmdCard" Width="200" Height="200" CornerRadius="24"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                                    Background="{StaticResource GlassSurfaceMediumBrush}"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="AmdCard_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image x:Name="AmdLogo" Width="120" Height="120"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="AMD" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextWhiteBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="DetectionNoteText" Margin="0,18,0,0" MaxWidth="440" TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="12" Foreground="{StaticResource TextLightGrayBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Étapes (après sélection ou détection) -->
            <StackPanel x:Name="StepsPanel" Visibility="Collapsed">
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,16"
                        Click="ChangeVendor_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{h:Loc Fr='Changer de carte graphique', En='Change graphics card'}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Border x:Name="OnboardingGpuStepsCard" Style="{StaticResource GlassCard}" Padding="24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Image x:Name="SelectedVendorLogo" Width="44" Height="44" Margin="0,0,14,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedVendorTitle" FontSize="{StaticResource FontMedium}"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock x:Name="SelectedVendorSubtitle" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="StepsHost" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Offre : pour ceux qui préfèrent déléguer -->
                <Border Style="{StaticResource GlassCard}" Margin="0,14,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{h:Loc Fr='Tu préfères qu’on s’en occupe ?', En='Rather have us do it?'}" FontSize="{StaticResource FontNormal}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock x:Name="GpuOfferText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextLightGrayBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PurpleButton}" VerticalAlignment="Center"
                                Content="{h:Loc Fr='Découvrir l’optimisation', En='Discover the optimization'}" Click="GpuOffer_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
