<UserControl x:Class="TweaksLabPanel.Views.NettoyerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="{StaticResource PageMargin}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <TextBlock Text="Nettoyer mon PC" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
            <TextBlock Text="Estime et nettoie les fichiers temporaires, la corbeille et le cache inutile."
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

            <Border Style="{StaticResource GlassCard}" Padding="24,20" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Espace récupérable estimé" FontSize="12"
                               Foreground="{StaticResource TextGrayBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EstimateText" Text="—" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,10"/>
                    <TextBlock x:Name="DetailText" Text="" FontSize="11" LineHeight="16"
                               Foreground="{StaticResource TextDimBrush}" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button x:Name="CleanBtn" Style="{StaticResource BlueButton}" Padding="22,12" Margin="0,0,10,0" Click="CleanAll_Click">
                    <TextBlock Text="Nettoyer" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="TournamentBtn" Style="{StaticResource OutlineButton}" Padding="22,12" Click="Tournament_Click">
                    <TextBlock Text="Avant tournoi" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>

            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock x:Name="LoadingStatus" Text="Préparation du nettoyage..."
                           Foreground="{StaticResource TextWhiteBrush}" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar x:Name="CleanProgress" Height="8" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="LoadingPercent" Text="0 %"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <TextBlock x:Name="ResultText" Text="" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource TextLightGrayBrush}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
