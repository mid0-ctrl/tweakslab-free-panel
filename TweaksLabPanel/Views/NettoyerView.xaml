<UserControl x:Class="TweaksLabPanel.Views.NettoyerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer Style="{StaticResource PageScrollViewer}" Margin="{StaticResource PageMargin}">
        <StackPanel HorizontalAlignment="Center" MaxWidth="560" Margin="0,8,0,0">
            <TextBlock Text="{h:Loc Fr='Nettoyer mon PC', En='Clean my PC'}" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>
            <TextBlock Text="{h:Loc Fr='Supprime les fichiers temporaires, les rapports d’erreurs, les fichiers de plantage et vide la corbeille.', En='Removes temporary files, error reports and crash dumps, and empties the Recycle Bin.'}"
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

            <Border Style="{StaticResource GlassCard}" Padding="24,18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{h:Loc Fr='Espace récupérable estimé', En='Estimated recoverable space'}" FontSize="12"
                               Foreground="{StaticResource TextGrayBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EstimateText" Text="…" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,12"/>
                    <StackPanel x:Name="StepsList"/>
                    <TextBlock Text="{h:Loc Fr='Les fichiers temporaires de moins de 24 h sont conservés pour ne pas gêner un jeu ou une installation en cours.', En='Temporary files less than 24 h old are kept so a running game or install isn’t disturbed.'}"
                               Margin="0,10,0,0" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextGrayBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button x:Name="CleanBtn" Style="{StaticResource BlueButton}" Padding="22,12" Margin="0,0,10,0" Click="CleanAll_Click">
                    <TextBlock Text="{h:Loc Fr='Nettoyer', En='Clean'}" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="TournamentBtn" Style="{StaticResource OutlineButton}" Padding="22,12" Click="Tournament_Click">
                    <TextBlock Text="{h:Loc Fr='Avant tournoi', En='Pre-match'}" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>

            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock x:Name="LoadingStatus"
                           Foreground="{StaticResource TextWhiteBrush}" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ProgressBar x:Name="CleanProgress" Height="8" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="LoadingPercent" Text="0 %"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <Border x:Name="ResultCard" Style="{StaticResource GlassCard}" Padding="20,16" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource TextWhiteBrush}" FontSize="14"/>
                    <StackPanel x:Name="ResultDetails" Margin="0,10,0,0"/>
                    <TextBlock x:Name="CleanupOfferLink" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Style="{StaticResource AccentLink}" MouseLeftButtonUp="CleanupOffer_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
