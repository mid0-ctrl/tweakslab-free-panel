<UserControl x:Class="TweaksLabPanel.Views.AssistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{h:Loc Fr='Assistance', En='Support'}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{h:Loc Fr='Discute avec Bryan : conseils PC et dépannage.', En='Chat with Bryan: PC advice and troubleshooting.'}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="OfferButton" Style="{StaticResource PurpleButton}" Padding="12,7" Margin="0,0,8,0"
                        Click="OfferButton_Click"/>
                <Button Style="{StaticResource OutlineButton}" Padding="12,7" FontSize="12" Content="Discord"
                        Click="DiscordButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
            <ScrollViewer x:Name="ChatScroll" Style="{StaticResource PageScrollViewer}">
                <StackPanel x:Name="ChatMessages"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{h:Loc Fr='Ton message', En='Your message'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" Grid.Column="0" Style="{StaticResource ChatInputBox}"
                         Margin="0,0,10,0" TextChanged="ChatInput_TextChanged"/>
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource BlueButton}"
                        Content="{h:Loc Fr='Envoyer', En='Send'}" Padding="20,12" Click="Send_Click"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource TextGrayBrush}" TextWrapping="Wrap"
                           Margin="0,0,80,0"/>
                <TextBlock x:Name="CharCounterText" FontSize="11" Foreground="{StaticResource TextGrayBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <Image x:Name="BotAvatar" Visibility="Collapsed"/>
        <Image x:Name="UserAvatar" Visibility="Collapsed"/>
    </Grid>
</UserControl>
