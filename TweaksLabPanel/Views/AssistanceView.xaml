<UserControl x:Class="TweaksLabPanel.Views.AssistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Assistance" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Discute avec Tetsuya : conseils PC et dépannage." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
            <ScrollViewer Style="{StaticResource PageScrollViewer}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Margin="0,0,12,0"
                                BorderBrush="{StaticResource AccentSoftBorderBrush}" BorderThickness="1">
                            <Image x:Name="TetsuyaAvatar" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tetsuya" Foreground="{StaticResource TextWhiteBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource ChatBubbleBot}" MaxWidth="420">
                                <TextBlock Text="Salut ! Je suis Tetsuya, ton assistant PC. Pose-moi une question sur l'optimisation, les performances ou le dépannage."
                                           Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Border Style="{StaticResource ChatBubbleUser}" MaxWidth="280">
                            <TextBlock Text="Comment optimiser mon PC pour le gaming ?"
                                       Foreground="{StaticResource TextWhiteBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                        <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Margin="12,0,0,0"
                                BorderBrush="{StaticResource AccentSoftBorderBrush}" BorderThickness="1">
                            <Image x:Name="UserAvatar" Stretch="UniformToFill"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ton message" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ChatInput" Grid.Column="0" Style="{StaticResource ChatInputBox}"
                     Margin="0,0,10,0" Tag="Écris ton message..."/>
            <Button Grid.Column="1" Style="{StaticResource PurpleButton}" Content="Envoyer" Padding="20,12"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
