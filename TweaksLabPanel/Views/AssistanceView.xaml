<UserControl x:Class="TweaksLabPanel.Views.AssistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Assistance" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Discute avec Bryan : conseils PC et dépannage." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
            <ScrollViewer x:Name="ChatScroll" Style="{StaticResource PageScrollViewer}">
                <StackPanel x:Name="ChatMessages"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ton message" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" Grid.Column="0" Style="{StaticResource ChatInputBox}"
                         Margin="0,0,10,0"/>
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource BlueButton}"
                        Content="Envoyer" Padding="20,12" Click="Send_Click"/>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" FontSize="11"
                       Foreground="{StaticResource TextGrayBrush}"/>
        </Grid>

        <Image x:Name="BotAvatar" Visibility="Collapsed"/>
        <Image x:Name="UserAvatar" Visibility="Collapsed"/>
    </Grid>
</UserControl>
