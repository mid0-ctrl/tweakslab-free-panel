<UserControl x:Class="TweaksLabPanel.Views.BackgroundLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:TweaksLabPanel.Helpers"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer x:Name="PageScroll" Style="{StaticResource PageScrollViewer}" Margin="{StaticResource PageMargin}">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PageScroll}" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Resources>
        <StackPanel HorizontalAlignment="Stretch">
            <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,16"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="BackButtonText" Text="{h:Loc Fr='Retour au profil', En='Back to profile'}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{h:Loc Fr='Bibliothèque d’arrière-plans', En='Background library'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{h:Loc Fr='Choisis un fond animé ou importe ta propre image.', En='Pick an animated background or import your own image.'}"
                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource GlassCard}" Padding="20,20,16,20" HorizontalAlignment="Stretch">
                <UniformGrid x:Name="BackgroundLibraryGrid" Columns="4" HorizontalAlignment="Stretch"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
