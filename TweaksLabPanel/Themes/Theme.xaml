<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="BgColor">#0D0A12</Color>
    <Color x:Key="SidebarColor">#120E1A</Color>
    <Color x:Key="AccentColor">#A855F7</Color>
    <Color x:Key="AccentIndigoColor">#7C5CFF</Color>
    <Color x:Key="TextPrimaryColor">#F5F3F8</Color>
    <Color x:Key="TextSecondaryColor">#8B8494</Color>
    <Color x:Key="TextMutedColor">#6E6878</Color>
    <Color x:Key="BorderSubtleColor">#2A2433</Color>
    <Color x:Key="GreenAccent">#4ADE80</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigoColor}"/>
    <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextLightGrayBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextGrayBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="GreenAccentBrush" Color="{StaticResource GreenAccent}"/>
    <SolidColorBrush x:Key="RedAccentBrush" Color="#EF4444"/>

    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/fonts/#Poppins, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontNormal">13</sys:Double>
    <sys:Double x:Key="FontMedium">15</sys:Double>
    <sys:Double x:Key="FontLarge">20</sys:Double>
    <sys:Double x:Key="FontHero">26</sys:Double>
    <sys:Double x:Key="FontDisplay">34</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="SmallTileCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="InnerPanelCornerRadius">20</CornerRadius>
    <Thickness x:Key="PageMargin">32,14,32,20</Thickness>
    <Thickness x:Key="CardPadding">20,16</Thickness>

    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#2214141F"/>
    <SolidColorBrush x:Key="GlassSurfaceLightBrush" Color="#3314141F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C3AED"/>
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#55A855F7"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#88000000"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="GoldAccentBrush" Color="#FBBF24"/>
    <Color x:Key="AvatarRingColor">#152238</Color>
    <SolidColorBrush x:Key="AvatarRingBrush" Color="{StaticResource AvatarRingColor}"/>
    <SolidColorBrush x:Key="AvatarRingGlowBrush" Color="#33152238"/>
    <LinearGradientBrush x:Key="DiamondStreakBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0FDFF" Offset="0"/>
        <GradientStop Color="#7DD3FC" Offset="0.45"/>
        <GradientStop Color="#BAE6FD" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentActiveBrush" Color="#557C3AED"/>
    <SolidColorBrush x:Key="AccentActiveBorderBrush" Color="#99A855F7"/>
    <SolidColorBrush x:Key="AccentGlowBorderBrush" Color="#88A855F7"/>
    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#442A2140"/>
    <SolidColorBrush x:Key="GlassSurfaceMediumBrush" Color="#4414141F"/>
    <SolidColorBrush x:Key="BorderFaintBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="WalletIdleBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="WalletSelectedBorderBrush" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#77FFFFFF"/>
    <SolidColorBrush x:Key="FooterBarBrush" Color="#D8100E16"/>
    <SolidColorBrush x:Key="FooterBarBorderBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="AccentIndigoSoftBrush" Color="#66A17BE0"/>
    <SolidColorBrush x:Key="IconBadgeBrush" Color="#22A855F7"/>
    <SolidColorBrush x:Key="ImportTileBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="InfoBadgeBgBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="InfoBadgeBorderBrush" Color="#88FFFFFF"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="RingProgressBrush" Color="#D9FFFFFF"/>

    <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.4"/>
        <GradientStop Color="#CC000000" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldLabelGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFDF5" Offset="0"/>
        <GradientStop Color="#FDE68A" Offset="0.4"/>
        <GradientStop Color="#FBBF24" Offset="0.75"/>
        <GradientStop Color="#F59E0B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CtaGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#9333EA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkBlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1B3A" Offset="0"/>
        <GradientStop Color="#1E3A8A" Offset="0.55"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBubbleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4AFFFFFF"/>
        <GradientStop Offset="0.12" Color="#24FFFFFF"/>
        <GradientStop Offset="0.5" Color="#302A2438"/>
        <GradientStop Offset="1" Color="#3A181422"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBubbleHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5CFFFFFF"/>
        <GradientStop Offset="0.12" Color="#30FFFFFF"/>
        <GradientStop Offset="0.5" Color="#3A2E3048"/>
        <GradientStop Offset="1" Color="#441C1828"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#38FFFFFF"/>
        <GradientStop Offset="0.09" Color="#14FFFFFF"/>
        <GradientStop Offset="0.4" Color="#242A2140"/>
        <GradientStop Offset="1" Color="#33120E1C"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardHoverBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#45FFFFFF"/>
        <GradientStop Offset="0.09" Color="#1CFFFFFF"/>
        <GradientStop Offset="0.4" Color="#2C322848"/>
        <GradientStop Offset="1" Color="#3A141822"/>
    </LinearGradientBrush>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Background" Value="{StaticResource GlassCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="GlassCardButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource GlassCardBackgroundBrush}"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassCardHoverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FA855F7"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Bd" Property="Background" Value="#557C3AED"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Margin" Value="10,10,0,4"/>
    </Style>

    <Style x:Key="SocialIconHost" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style x:Key="PurpleButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource CtaGradientBrush}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource PurpleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource DarkBlueGradientBrush}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CreatorBubbleButton" TargetType="Button" BasedOn="{StaticResource BlueButton}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource DarkBlueGradientBrush}"
                            CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="13" Background="#331A1622"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Ellipse x:Name="thumb" Width="20" Height="20" Margin="3,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{StaticResource TextLightGrayBrush}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#55A855F7"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="#88A855F7"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource TextWhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="track" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassBubbleButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="24,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource GlassBubbleBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1.5"
                            CornerRadius="50"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassBubbleHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#99FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontNormal}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#3314141F" BorderBrush="#55FFFFFF" BorderThickness="1"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4414141F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontHero}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="ReadOnlyField" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="AccentLink" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TileCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource TileCornerRadius}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFaintBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThemePreviewTile" TargetType="Border" BasedOn="{StaticResource TileCard}">
        <Setter Property="CornerRadius" Value="{StaticResource SmallTileCornerRadius}"/>
    </Style>

    <Style x:Key="InnerGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>

    <Style x:Key="GlassExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontNormal}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="ExpandDirection" Value="Down"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="#1A141022"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          FocusVisualStyle="{x:Null}"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBd" Padding="14,12" Background="Transparent" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;"
                                                           FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <Border x:Name="ExpandSite" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Padding="14,0,14,12" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,0">
                                <ContentPresenter/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InfoBadge" TargetType="Border">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="{StaticResource InfoBadgeBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoBadgeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="InfoShowcasePanel" TargetType="Border">
        <Setter Property="Background" Value="#3A152238"/>
        <Setter Property="BorderBrush" Value="#77A855F7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{StaticResource IconBadgeBrush}"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="AccentPillButton" TargetType="Border">
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource AccentActiveBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentActiveBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontNormal}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="22,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource GlassSurfaceMediumBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                            CornerRadius="{StaticResource InnerPanelCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource GlassSurfaceMediumBrush}"
                            BorderBrush="{StaticResource AccentSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HoverCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}"/>
        <Setter Property="Background" Value="#3D1B1526"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A243550"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChatBubbleUser" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="#44A855F7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="ChatBubbleBot" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="ChatInputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontNormal}"/>
        <Setter Property="Background" Value="{StaticResource GlassSurfaceLightBrush}"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaceholderBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <!-- Scrollbar sidebar : fine, blanche, discrète -->
    <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="MaxWidth" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Margin" Value="0,2,4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="White" CornerRadius="2" Opacity="0.55"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid ClipToBounds="True" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
                                               CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource SidebarScrollBar}"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource SidebarScrollViewer}"/>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Aucun pointillé de focus clavier dans toute l'application -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

</ResourceDictionary>
