<Window x:Class="TweaksLabPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tweaks Lab Panel"
        Width="1000" Height="660" MinWidth="860" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="RootContent" CornerRadius="32" Background="{StaticResource BgBrush}"
            BorderThickness="0" ClipToBounds="True"
            SizeChanged="RootContent_SizeChanged"
            PreviewMouseDown="RootContent_PreviewMouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="AppShell" Grid.ColumnSpan="2">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Fond samouraï pleine fenêtre -->
            <Border Grid.ColumnSpan="2" CornerRadius="32" ClipToBounds="True" Panel.ZIndex="0" IsHitTestVisible="False">
                <Grid ClipToBounds="True">
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#330D0A12" Offset="0"/>
                                <GradientStop Color="#8C0D0A12" Offset="0.45"/>
                                <GradientStop Color="#E60D0A12" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>

            <!-- Sidebar : ombre pleine hauteur, logo hors zone nav -->
            <Grid x:Name="SidebarChrome" Grid.Column="0" Panel.ZIndex="1">
                <Border x:Name="SidebarHost" CornerRadius="32,0,0,32" ClipToBounds="True"
                        Background="#660F0B16" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"/>

                <StackPanel Panel.ZIndex="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="12,28,12,0">
                    <Image x:Name="SidebarLogo" Width="58" Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" Stretch="Uniform"/>
                </StackPanel>

                <Grid Margin="0,82,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Margin="12,0,4,0" Style="{StaticResource SidebarScrollViewer}"
                                  Focusable="False" FocusVisualStyle="{x:Null}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SidebarChrome}" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="NavPanel" Focusable="False" FocusVisualStyle="{x:Null}"
                                    Margin="0,6,2,8" ClipToBounds="True"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="12,0,12,16">
                        <Border Margin="0,0,0,10" Height="1" Background="#33FFFFFF"/>

                        <UniformGrid x:Name="SocialPanel" Rows="1" Columns="5" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <Border x:Name="ProfileCard" Style="{StaticResource HoverCard}"
                                Padding="10,8" Margin="0,0,0,8" Focusable="False"
                                MouseLeftButtonUp="ProfileCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,10,0"
                                      VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="42" Height="42"
                                             Stroke="{StaticResource AvatarRingBrush}"
                                             StrokeThickness="1.5" Opacity="0.95"/>
                                    <Ellipse Width="38" Height="38" Fill="{StaticResource AvatarRingGlowBrush}"/>
                                    <Border Width="34" Height="34" CornerRadius="17"
                                            BorderBrush="#66FFFFFF" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border x:Name="SidebarAvatarHost" CornerRadius="16" ClipToBounds="True" Background="#1AFFFFFF">
                                            <Image x:Name="SidebarAvatar" Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Border>
                                    </Border>
                                </Grid>

                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="SidebarPseudo" Grid.Row="0" Grid.Column="1"
                                               Text="" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextWhiteBrush}"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SidebarBio" Grid.Row="1" Grid.Column="1"
                                               Text="" FontSize="9" FontStyle="Italic"
                                               Foreground="#6E6878"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{StaticResource TextWhiteBrush}" Margin="0,4,0,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Free Panel" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextWhiteBrush}" Margin="0,4,0,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Zone droite -->
            <Grid Grid.Column="1" Panel.ZIndex="1" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                      Focusable="False" FocusVisualStyle="{x:Null}"
                      KeyboardNavigation.TabNavigation="None"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid x:Name="NotifBtnHost" Width="48" Height="44" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Ellipse Width="34" Height="34" Fill="#33FFFFFF"/>
                            <Ellipse Width="34" Height="34" Stroke="#66FFFFFF" StrokeThickness="1"/>
                            <Button x:Name="NotifBtn" Width="44" Height="44" Click="Notif_Click"
                                    Style="{StaticResource ChromeButton}" ToolTip="Notifications">
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="White"/>
                            </Button>
                            <Border x:Name="NotifBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                                    MinWidth="15" Height="15" CornerRadius="7.5" Background="#EF4444" IsHitTestVisible="False">
                                <TextBlock x:Name="NotifBadgeText" Text="1" Foreground="White" FontSize="8" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Close_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <Popup x:Name="NotifPopup" PlacementTarget="{Binding ElementName=NotifBtn}"
                           Placement="Bottom" HorizontalOffset="-208" VerticalOffset="-4"
                           StaysOpen="True" AllowsTransparency="True" PopupAnimation="None"
                           Closed="NotifPopup_Closed">
                        <Border x:Name="NotifPanel" Width="250" CornerRadius="14" Padding="13"
                                BorderBrush="#4DA17BE0" BorderThickness="1"
                                RenderTransformOrigin="1,0" Opacity="0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NotifScale" ScaleX="0.86" ScaleY="0.86"/>
                                    <TranslateTransform x:Name="NotifTranslate" Y="-10"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#BF33284F"/>
                                    <GradientStop Offset="1" Color="#BF17121F"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Notifications" FontSize="{StaticResource FontNormal}"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"/>
                                <Border Margin="0,10,0,0" CornerRadius="10" Padding="12"
                                        BorderBrush="#33A17BE0" BorderThickness="1" Background="#1FFFFFFF">
                                    <TextBlock Text="Bienvenue à toi BETA Testeur" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextWhiteBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <ContentControl x:Name="PageContent" Grid.Row="1"
                                Focusable="False" FocusVisualStyle="{x:Null}"/>

                <TextBlock x:Name="EasterEggHint" Grid.Row="1" Text="TWEAKS10"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,14,10" FontSize="9" Opacity="0.22"
                           Foreground="{StaticResource TextWhiteBrush}" Visibility="Collapsed"
                           IsHitTestVisible="False"/>
            </Grid>
            </Grid>
            </Grid>

            <!-- Pseudo — premier lancement (une seule fenêtre) -->
            <Border x:Name="PseudoOverlay" Grid.ColumnSpan="2" Panel.ZIndex="200"
                    Background="#660D0A12" Visibility="Collapsed">
                <Border Style="{StaticResource GlassCard}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="440" MinWidth="380" Padding="40,36">
                    <StackPanel>
                        <TextBlock Text="À qui ai-je l'honneur de faire connaissance ?" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextWhiteBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,22"/>

                        <Border Background="{StaticResource GlassSurfaceLightBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                                CornerRadius="16" Padding="4">
                            <TextBox x:Name="PseudoInput" MaxLength="24" MinHeight="48"
                                     FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextWhiteBrush}"
                                     Background="Transparent" BorderThickness="0"
                                     CaretBrush="White" Padding="14,10" TextAlignment="Center"
                                     TextChanged="PseudoInput_TextChanged" KeyDown="PseudoInput_KeyDown"/>
                        </Border>

                        <Button x:Name="PseudoContinueBtn" Style="{StaticResource BlueButton}" Margin="0,26,0,0"
                                Padding="22,12" IsEnabled="False" Click="PseudoContinue_Click">
                            <TextBlock Text="Continuer" FontSize="15" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <Grid x:Name="OnboardingOverlay" Grid.ColumnSpan="2" Panel.ZIndex="190"
                  Visibility="Collapsed" Background="Transparent" IsHitTestVisible="True"
                  SizeChanged="OnboardingOverlay_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="OnboardingCanvas" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                        Panel.ZIndex="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        IsHitTestVisible="True">
                    <Rectangle x:Name="DimTop" Fill="#F00D0A12" IsHitTestVisible="True"/>
                    <Rectangle x:Name="DimLeft" Fill="#F00D0A12" IsHitTestVisible="True"/>
                    <Rectangle x:Name="DimRight" Fill="#F00D0A12" IsHitTestVisible="True"/>
                    <Rectangle x:Name="DimBottom" Fill="#F00D0A12" IsHitTestVisible="True"/>
                </Canvas>
                <Border x:Name="OnboardingCard" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                        Panel.ZIndex="10" Style="{StaticResource GlassCard}"
                        RenderTransformOrigin="0.5,0.5" Opacity="1"
                        BorderThickness="1.5" CornerRadius="18" ClipToBounds="False"
                        MaxWidth="420" MinWidth="300" Padding="28,24" Margin="20,10,20,16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#AA6366F1" Offset="0"/>
                            <GradientStop Color="#884F8EF7" Offset="0.45"/>
                            <GradientStop Color="#AA3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F8161222" Offset="0"/>
                            <GradientStop Color="#F5100D18" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#6366F1" BlurRadius="22" ShadowDepth="0" Opacity="0.38"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="OnboardingCardScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="OnboardingCardTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="OnboardingTitle" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextWhiteBrush}" TextAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="OnboardingBody" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"
                                   FontSize="13" Foreground="{StaticResource TextGrayBrush}" Margin="0,0,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="OnboardingSkipBtn" Style="{StaticResource OutlineButton}" Padding="18,10" Margin="0,0,10,0"
                                    Click="OnboardingSkip_Click">
                                <TextBlock x:Name="OnboardingSkipLabel" Text="Passer"/>
                            </Button>
                            <Button x:Name="OnboardingNextBtn" Style="{StaticResource BlueButton}" Padding="18,10" Click="OnboardingNext_Click">
                                <TextBlock x:Name="OnboardingNextLabel" Text="Suivant" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="OnboardingDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
